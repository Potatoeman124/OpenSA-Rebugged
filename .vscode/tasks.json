{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OpenSA: Build",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "${workspaceFolder}/build-pipeline.cmd",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        }
    ]
}
